{
  "version": 2,
  "name": "india-geo-saas",
  "regions": ["sin1"],
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "api/src/app.js": {
      "runtime": "@vercel/node",
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/api/v1/states",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=86400, stale-while-revalidate=3600" }
      ]
    },
    {
      "source": "/api/v1/districts",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=86400, stale-while-revalidate=3600" }
      ]
    },
    {
      "source": "/api/v1/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Powered-By", "value": "India Geo SaaS" }
      ]
    }
  ],
  "routes": [
    {
      "src": "/health",
      "dest": "src/app.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "src/app.js"
    }
  ]
}
