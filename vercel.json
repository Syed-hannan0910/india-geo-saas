{
  "version": 2,
  "name": "india-geo-api",
  "builds": [
    {
      "src": "api/src/app.js",
      "use": "@vercel/node",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/health",
      "dest": "api/src/app.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "api/src/app.js",
      "headers": {
        "Cache-Control": "s-maxage=0"
      }
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "regions": ["bom1", "sin1"],
  "functions": {
    "api/src/app.js": {
      "memory":  1024,
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/api/v1/states",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=86400, stale-while-revalidate=3600" }
      ]
    },
    {
      "source": "/api/v1/districts",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=86400, stale-while-revalidate=3600" }
      ]
    },
    {
      "source": "/api/v1/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",         "value": "DENY" },
        { "key": "X-Powered-By",            "value": "India Geo SaaS" }
      ]
    }
  ]
}
